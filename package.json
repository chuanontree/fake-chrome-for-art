{
  "name": "chuanontree-browser",
  "version": "0.1.0",
  "description": "偽 Chrome — a browser that is not a browser. 介面作為隱形作者。",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve -l 5173 .",
    "start": "npx --yes serve -l 5173 .",
    "app": "electron .",
    "kiosk": "electron . --kiosk",
    "package:mac": "electron-packager . chuanontree --out=dist --overwrite --app-bundle-id=io.github.chuanontree.browser --platform=darwin --arch=universal --ignore=\"^/dist\" --ignore=\"^/[.]github\" --ignore=\"^/(CLAUDE|README)[.]md\" --ignore=\"^/td-threads\"",
    "package:win": "electron-packager . chuanontree --out=dist --overwrite --app-bundle-id=io.github.chuanontree.browser --platform=win32 --arch=x64 --ignore=\"^/dist\" --ignore=\"^/[.]github\" --ignore=\"^/(CLAUDE|README)[.]md\" --ignore=\"^/td-threads\"",
    "package:linux": "electron-packager . chuanontree --out=dist --overwrite --app-bundle-id=io.github.chuanontree.browser --platform=linux --arch=x64 --ignore=\"^/dist\" --ignore=\"^/[.]github\" --ignore=\"^/(CLAUDE|README)[.]md\" --ignore=\"^/td-threads\""
  },
  "author": "chuanontree (Wu Wei-Chieh)",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5"
  }
}
